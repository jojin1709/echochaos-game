# EchoChaos — Frontend environment variables (Next.js / Vercel)
# Copy this file to .env.local for local development.

# URL of the deployed (or local) EchoChaos Socket.IO server.
# Local dev default matches the server's default PORT (4000).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Only needed if you wire the frontend directly to Supabase for anything
# client-side in the future (the v1 game does not require this — the server
# is the only thing that talks to Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
