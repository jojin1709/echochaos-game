# EchoChaos — Server environment variables (Node/Express/Socket.IO, e.g. Render)
# Copy this file to .env for local development (the server reads process.env
# directly; add a `dotenv` import in src/index.ts if you want .env file
# loading in local dev, or export these vars in your shell).

# Port the HTTP + Socket.IO server listens on.
PORT=4000

# Must exactly match the deployed frontend's origin (scheme + host, no
# trailing slash), or the browser will block the Socket.IO connection.
CORS_ORIGIN=http://localhost:3000

# Supabase project credentials. Only required if you wire the server's
# challenge bank to Supabase Postgres/Storage instead of the built-in
# in-memory catalog (server/src/game/challenges.ts). The v1 game runs fully
# without these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
